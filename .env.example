# Root / Cross-Cutting Environment Template
# Copy to .env and fill. Used by dev tooling, MCP, and shared config.
# NEVER commit .env — it may contain secrets.

# Master test toggle (Phase 3.0) — set to 'true' to activate testing
TEST_ENABLED=false

# GitHub PAT for MCP server integration (optional)
# GIT_MCP_SERVER=

# Logger: client uses VITE_* prefix (Vite requirement)
# VITE_LOG_LEVEL=warn
# VITE_LOG_CALLSITE=1
# VITE_DEBUG_SCOPES=
# VITE_APP_STAGE=local
# VITE_INCLUDE_DEV_FLAGS=false
