{
  "ignorePathPrefixes": [
    "client/src/utils/",
    "shared/",
    "client/src/types/transformers/",
    "client/src/plugins/",
    "client/src/router/"
  ],
  "domains": {
    "booking": {
      "clientPaths": ["client/src/composables/booking/", "client/src/components/booking/", "client/src/views/booking/", "client/src/types/booking/", "client/src/utils/booking/"],
      "serverPaths": ["server/src/routes/internal/appointments", "server/src/routes/internal/availability", "server/src/routes/internal/properties", "server/src/services/availability"],
      "composablePrefixes": ["useBooking", "useAvailability", "useWizard", "useAppointment"],
      "modelNames": ["Appointment", "Selection", "TimeSlot", "Property", "Fee"]
    },
    "admin": {
      "clientPaths": ["client/src/composables/admin/", "client/src/components/admin/", "client/src/views/admin/", "client/src/types/admin/"],
      "serverPaths": ["server/src/routes/internal/entities", "server/src/routes/internal/relationships", "server/src/routes/internal/admin-metadata"],
      "composablePrefixes": ["useAdmin", "useEntity"],
      "modelNames": ["Shape", "Instance", "WizardSetting"]
    },
    "auth": {
      "clientPaths": ["client/src/composables/auth/"],
      "serverPaths": ["server/src/routes/internal/auth", "server/src/auth/", "server/src/db/models/auth"],
      "composablePrefixes": ["useAuth", "useSession"],
      "modelNames": ["User", "Session", "MagicLink"]
    },
    "integrations": {
      "clientPaths": ["client/src/services/calendarApiService", "client/src/services/mapsApiService", "client/src/services/propertyEnrichmentApiService"],
      "serverPaths": ["server/src/routes/external/", "server/src/services/google/"],
      "composablePrefixes": [],
      "modelNames": []
    },
    "beta": {
      "clientPaths": ["client/src/composables/beta/", "client/src/views/beta/", "client/src/components/beta/"],
      "serverPaths": ["server/src/routes/internal/beta-feedback"],
      "composablePrefixes": ["useBeta"],
      "modelNames": ["BetaFeedback"]
    }
  }
}
