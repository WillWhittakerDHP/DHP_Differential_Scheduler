{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".cursor/commands/harness/contracts.ts",
    ".cursor/commands/harness/reason-code.ts",
    ".cursor/commands/harness/adapters.ts",
    ".cursor/commands/harness/step-graph.ts",
    ".cursor/commands/harness/kernel.ts",
    "vitest.config.workspace.cursor.ts"
  ],
  "exclude": [
    "node_modules",
    "client/node_modules",
    "server/node_modules"
  ]
}
