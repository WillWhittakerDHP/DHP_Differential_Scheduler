node_modules
dist
.env
.env.*
*.log
coverage

# Google OAuth tokens (contains sensitive credentials)
.google-tokens.json

# Comment audit reports (regenerate as needed)
COMMENT_AUDIT_REPORT.md
comment-audit-data.json

# Ignore dated property configuration backups
backups/property-configs/property-config-*.json

# Track the latest backup
!backups/property-configs/property-config-latest.json

# Ignore .cursor nested git repository (synced separately)
.cursor/.git

# Pending state for /accepted-proceed and /accepted-code (chat-first flow)
.cursor/commands/.tier-start-pending.json
.cursor/commands/.task-start-pending.json

# MCP config with machine-specific paths (copy from .cursor/mcp.json.example)
.cursor/mcp.json
# Cloned Gmail MCP server (third-party)
.cursor/gmail-mcp-server

# Auto-generated type declarations (regenerated by dev server)
client/auto-imports.d.ts

# Transient workflow state (generated during harness execution, not project artifacts)
.project-manager/.git-ops-log
.project-manager/.write-log
# Machine-local harness state (avoids merge conflicts when two machines work different branches)
.project-manager/.tier-scope
.project-manager/.audit-baseline-log.jsonl
