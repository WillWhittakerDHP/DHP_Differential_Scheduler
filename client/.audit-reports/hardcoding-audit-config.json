{
  "$comment": "Configuration for hardcoding-audit.mjs exception handling",
  "$schema": "Allowlist for intentional/necessary hardcoding patterns",
  "allowlist": {
    "patterns": [
      {
        "glob": "**/constants/**/*.ts",
        "ruleIds": [
          "*"
        ],
        "reason": "Constants files are the canonical source for hardcoded values - this is by design"
      },
      {
        "glob": "**/configs/**/*.ts",
        "ruleIds": [
          "magicLabel",
          "caseString",
          "fieldEqualsString"
        ],
        "reason": "Config files are intentional sources of hardcoded values - canonical source of truth"
      },
      {
        "glob": "**/configs/**/*.js",
        "ruleIds": [
          "magicLabel",
          "caseString",
          "fieldEqualsString"
        ],
        "reason": "Config files are intentional sources of hardcoded values - canonical source of truth"
      },
      {
        "glob": "**/*Display*.ts",
        "ruleIds": [
          "magicLabel",
          "caseString"
        ],
        "reason": "Display config files define labels and case literals by design"
      },
      {
        "glob": "**/*Display*.vue",
        "ruleIds": [
          "magicLabel",
          "caseString"
        ],
        "reason": "Display components use label strings and case literals by design"
      },
      {
        "glob": "**/*.vue",
        "ruleIds": [
          "entityKeyString"
        ],
        "reason": "Vue slot names and template attributes legitimately use entity keys as strings"
      },
      {
        "glob": "**/utils/logger.ts",
        "ruleIds": [
          "caseString"
        ],
        "reason": "Log level strings are standard and intentional - part of logger API"
      },
      {
        "glob": "**/types/**/*.ts",
        "ruleIds": [
          "entityKeyString",
          "caseString"
        ],
        "reason": "Type definitions legitimately use string literals for type unions"
      },
      {
        "glob": "**/transformers/**/*.ts",
        "ruleIds": [
          "entityKeyString"
        ],
        "reason": "API transformers necessarily reference entity keys for type-safe mapping"
      }
    ],
    "specific": []
  },
  "priorities": {
    "p0MinSeverityScore": 20,
    "p1MinSeverityScore": 10
  }
}