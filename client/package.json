{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "typecheck:audit": "node .scripts/typecheck-audit.mjs",
    "typecheck:summary": "node .scripts/typecheck-audit-summary.mjs",
    "typecheck:run": "node .scripts/typecheck-run.mjs",
    "audit:component-logic": "node .scripts/component-logic-audit.mjs",
    "audit:component-logic:summary": "node .scripts/component-logic-audit-summary.mjs",
    "audit:composables-logic": "node .scripts/composables-logic-audit.mjs",
    "audit:composables-logic:summary": "node .scripts/composables-logic-audit-summary.mjs",
    "audit:loop-mutations": "node .scripts/loop-mutation-audit.mjs",
    "audit:loop-mutations:summary": "node .scripts/loop-mutation-audit-summary.mjs",
    "audit:hardcoding": "node .scripts/hardcoding-audit.mjs",
    "audit:hardcoding:summary": "node .scripts/hardcoding-audit-summary.mjs",
    "audit:duplication": "node .scripts/duplication-audit.mjs",
    "audit:duplication:summary": "node .scripts/duplication-audit-summary.mjs",
    "audit:test": "node .scripts/test-audit.mjs",
    "audit:test:summary": "node .scripts/test-audit-summary.mjs",
    "audit:test:cleanup": "node .scripts/test-cleanup.mjs",
    "audit:test:generate": "node .scripts/test-logic-generator.mjs",
    "audit:test:generate:api": "node .scripts/test-generate-api.mjs",
    "audit:test:ai": "node .scripts/test-generate-for-ai.mjs",
    "audit:fallback": "node .scripts/fallback-audit.mjs",
    "audit:unused-code": "node .scripts/unused-code-audit.mjs",
    "audit:unused-code:summary": "node .scripts/unused-code-audit-summary.mjs",
    "audit:all": "npm run typecheck:audit && npm run audit:component-logic && npm run audit:composables-logic && npm run audit:loop-mutations && npm run audit:hardcoding && npm run audit:duplication && npm run audit:test && npm run audit:fallback && npm run audit:unused-code && npm run typecheck:summary && npm run audit:component-logic:summary && npm run audit:composables-logic:summary && npm run audit:loop-mutations:summary && npm run audit:hardcoding:summary && npm run audit:duplication:summary && npm run audit:test:summary && npm run audit:unused-code:summary",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@casl/ability": "^6.7.3",
    "@casl/vue": "^2.2.2",
    "@floating-ui/dom": "^1.6.8",
    "@formkit/drag-and-drop": "0.1.6",
    "@iconify/vue": "^4.1.2",
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.90.7",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.13.2",
    "cookie-es": "^1.2.2",
    "date-fns": "^4.1.0",
    "destr": "^2.0.5",
    "ofetch": "^1.5.0",
    "pinia": "^3.0.4",
    "type-fest": "^5.2.0",
    "ufo": "^1.6.1",
    "uuid": "^13.0.0",
    "vee-validate": "^4.15.1",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.24",
    "vue-flatpickr-component": "^11.0.5",
    "vue-router": "^4.6.3",
    "vue3-perfect-scrollbar": "^2.0.0",
    "vuetify": "^3.10.9",
    "webfontloader": "^1.6.28",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/vue-3": "^2.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.23",
    "@types/node": "^24.10.0",
    "@types/uuid": "^10.0.0",
    "@types/webfontloader": "^1.6.38",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^10.5.1",
    "jsdom": "^27.0.0",
    "sass": "^1.93.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "unplugin-auto-import": "^20.2.0",
    "vite": "^7.2.2",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^2.1.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.3"
  }
}
