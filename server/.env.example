# Server Environment Template
# Copy to .env.development or .env.production and fill with real values.
# NEVER commit .env.development or .env.production — they contain secrets.

# Server
SERVER_PORT=3001
# Alternative: PORT is also read by index.ts

# Database (required for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scheduler_db
DB_USER=postgres
DB_PASSWORD=

# Database test override (optional)
# TEST_DB_NAME=scheduler_test

# App
NODE_ENV=development
APP_STAGE=local

# Authentication (Feature 7) — validated in envConfig.ts
# AUTH_STRATEGY=none | magic_link | password
AUTH_STRATEGY=none
AUTH_SESSION_COOKIE_NAME=dhp_sid
# Max-Age for session cookie (seconds); min 60 in Joi
AUTH_SESSION_MAX_AGE_SEC=604800

# Magic link row lifetime (seconds). Optional; invalid values fall back to 900 (15m) with a server warn.
# MAGIC_LINK_TTL_SECONDS=900

# How magic-link emails are “delivered” in this build: log (default) or smtp (smtp not implemented — falls back to log with a warn).
# MAGIC_LINK_DELIVERY_MODE=log

# Client-facing base URL for invite template links (reschedule, cancel) and Feature 7 magic-link verify URLs.
# Used by inviteContextBuilder when building {rescheduleLink} and {cancelLink}; also `buildMagicLinkVerifyUrl` in auth.
# Example: https://yourdomain.com (no trailing slash)
APP_BASE_URL=

# Optional: server also reads VITE_APP_BASE_URL as fallback for invites
# VITE_APP_BASE_URL=

# Magic link — API verify (Feature 7.3.3). Email links use buildMagicLinkVerifyUrl → client path /auth/verify?token=…;
# the Vue app (Feature 7.4) will call the API below. Dev smoke (replace RAW_TOKEN from server logs when MAGIC_LINK_DELIVERY_MODE=log):
# GET http://localhost:3001/api/v1/internal/auth/magic-link/verify?token=RAW_TOKEN

# Logging (optional)
# LOG_LEVEL=info
# DEBUG_SCOPES=
# LOG_CALLSITE=1
# VITE_LOG_CALLSITE=1

# Google OAuth / Calendar (required for calendar features)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# GOOGLE_SCOPES= (comma-separated; has default)
# GOOGLE_API_KEY= (optional, for some APIs)

# Google Calendar rate/cache (optional, defaults in code)
# GOOGLE_CALENDAR_RATE_LIMIT_PER_MINUTE=60
# GOOGLE_CALENDAR_CACHE_TTL_MINUTES=5

# Calendar import script (optional)
# ORGANIZER_EMAIL=

# Bright MLS / RESO Property Enrichment
# Get credentials from contentlicensing@brightmls.com
BRIGHT_MLS_API_URL=
BRIGHT_MLS_CLIENT_ID=
BRIGHT_MLS_CLIENT_SECRET=
# Or if they provide a Bearer token directly:
BRIGHT_MLS_ACCESS_TOKEN=
# OAuth token endpoint (required if using client credentials):
BRIGHT_MLS_TOKEN_URL=
# BRIGHT_MLS_RATE_LIMIT_PER_SECOND=2
# BRIGHT_MLS_RATE_LIMIT_PER_DAY=40000

# Cache TTL overrides (optional)
# PROPERTY_ENRICHMENT_CACHE_TTL_MINUTES=60
# ADDRESS_GEOCODING_CACHE_TTL_DAYS=
# DRIVE_TIME_CACHE_TTL_HOURS=24
