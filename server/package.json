{
  "name": "express-api-typescript",
  "author": "p-rk",
  "version": "0.0.2",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -e ts --exec \"npm run compile && npm run start\"",
    "compile": "tsc && tsc-alias -p tsconfig.json",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/server/src/index.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose --coverage --detectOpenHandles --forceExit",
    "backup:properties": "npm run compile && node dist/scripts/backup-properties.js",
    "migrate": "node src/scripts/run-migrations.mjs",
    "migrate:status": "npx sequelize-cli db:migrate:status --config src/db/config/database.mjs --migrations-path src/db/migrations",
    "migrate:undo": "dotenv -e .env npx sequelize-cli db:migrate:undo --config src/db/config/database.mjs --migrations-path src/db/migrations",
    "migrate:undo:all": "dotenv -e .env npx sequelize-cli db:migrate:undo:all --config src/db/config/database.mjs --migrations-path src/db/migrations",
    "fix-mjs": "for f in src/db/migrations/*.js; do mv \"$f\" \"${f%.js}.mjs\"; done",
    "generate-js": "dotenv -e .env npx sequelize-cli migration:generate --config src/db/config/database.mjs --migrations-path src/db/migrations --name",
    "db:migrate:generate": "npm run generate-js -- \"$1\" && npm run fix-mjs",
    "db:migrate:undo": "dotenv -e .env npx sequelize-cli db:migrate:undo --config src/db/config/database.mjs --migrations-path src/db/migrations",
    "import:calendar": "npm run compile && node dist/scripts/importCalendarData.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "boilerplate",
    "starterkit",
    "express-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/p-rk/express-api-typescript.git"
  },
  "dependencies": {
    "@sequelize/core": "^7.0.0-alpha.48",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "glob": "^10.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.0",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "tsc-alias": "^1.8.10"
  }
}